# Caddy TLS snippet for the HOME / LAN deployment (TLS_MODE=local).
#
# Imported by ../Caddyfile. This tells Caddy to serve the locally-trusted
# certificate generated by scripts/make-certs.sh with mkcert and mounted at
# /etc/caddy/certs by compose.yaml. Because the cert/key file names are derived
# from SITE_HOST, they must match what scripts/make-certs.sh produced:
#   certs/${SITE_HOST}.pem  and  certs/${SITE_HOST}-key.pem
#
# {$SITE_HOST} is substituted from the SITE_HOST environment variable before the
# Caddyfile is parsed (see compose.yaml), and compose.yaml fails fast if it is
# missing or empty in .env.
tls /etc/caddy/certs/{$SITE_HOST}.pem /etc/caddy/certs/{$SITE_HOST}-key.pem