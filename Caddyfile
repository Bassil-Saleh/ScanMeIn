# Caddyfile for the Ticket Project Docker deployment (home network AND public
# server). Caddy terminates HTTPS and routes traffic to the frontend and backend
# services on the internal Docker network. Caddy automatically redirects HTTP
# (port 80) to HTTPS (port 443).
#
# The certificate source is selected by the TLS_MODE environment variable (set
# by the Makefile target and/or .env, and passed to the caddy container in
# compose.yaml):
#   * TLS_MODE=local  (home / LAN)     -> the mkcert certificate generated by
#     scripts/make-certs.sh, mounted at /etc/caddy/certs (caddy/local.caddy).
#   * TLS_MODE=public (public server)  -> a real Let's Encrypt certificate
#     obtained via the Cloudflare DNS-01 challenge (caddy/public.caddy).
# The matching snippet is imported below and defaults to "local" when TLS_MODE
# is unset (e.g. a plain `docker compose up`).
#
# {$SITE_HOST} is substituted from the SITE_HOST environment variable passed to
# the caddy container in compose.yaml. compose.yaml fails fast if SITE_HOST is
# missing or empty in .env.

{$SITE_HOST} {
    # Pull in the deployment-appropriate `tls` directive (mkcert or Let's
    # Encrypt). Caddy substitutes {$TLS_MODE} before parsing, so the imported
    # file name is /etc/caddy/snippets/local.caddy or .../public.caddy.
    import /etc/caddy/snippets/{$TLS_MODE:local}.caddy

    # REST API -> Spring Boot backend.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # API documentation (springdoc / Swagger UI) -> Spring Boot backend.
    handle /swagger-ui/* {
        reverse_proxy backend:8080
    }
    handle /v3/api-docs* {
        reverse_proxy backend:8080
    }

    # Everything else -> the React frontend.
    handle {
        reverse_proxy frontend:80
    }
}
